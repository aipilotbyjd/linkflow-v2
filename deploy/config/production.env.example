# ============================================================================
# LinkFlow - Production Environment
# NEVER commit actual values! Use platform secrets.
# ============================================================================

# App
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.linkflow.io
APP_FRONTEND_URL=https://app.linkflow.io

# Database (use managed database)
DB_HOST=${DB_HOST}
DB_PORT=5432
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=linkflow
DB_SSLMODE=require
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE=10

# Redis (use managed Redis)
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_TLS=true

# JWT (rotate every 90 days)
JWT_SECRET=${JWT_SECRET}
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (never rotate without migration plan)
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# Scaling
API_REPLICAS=2
WORKER_REPLICAS=2
API_MIN_REPLICAS=2
API_MAX_REPLICAS=10
WORKER_MIN_REPLICAS=2
WORKER_MAX_REPLICAS=10

# OAuth
OAUTH_GOOGLE_CLIENT_ID=${OAUTH_GOOGLE_CLIENT_ID}
OAUTH_GOOGLE_CLIENT_SECRET=${OAUTH_GOOGLE_CLIENT_SECRET}
OAUTH_GITHUB_CLIENT_ID=${OAUTH_GITHUB_CLIENT_ID}
OAUTH_GITHUB_CLIENT_SECRET=${OAUTH_GITHUB_CLIENT_SECRET}

# Email
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=noreply@linkflow.io

# Storage
S3_ENDPOINT=${S3_ENDPOINT}
S3_BUCKET=linkflow-production
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
S3_REGION=auto

# Stripe (LIVE keys)
STRIPE_SECRET_KEY=${STRIPE_LIVE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_LIVE_WEBHOOK_SECRET}

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
PROMETHEUS_ENABLED=true

# Backup
BACKUP_S3_ENDPOINT=${BACKUP_S3_ENDPOINT}
BACKUP_S3_BUCKET=linkflow-backups
BACKUP_S3_ACCESS_KEY=${BACKUP_S3_ACCESS_KEY}
BACKUP_S3_SECRET_KEY=${BACKUP_S3_SECRET_KEY}
