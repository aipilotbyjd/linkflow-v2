# LinkFlow - Local Development

APP_ENV=local
APP_DEBUG=true

# Database (used by docker-compose for Postgres container)
DB_USER=linkflow
DB_PASSWORD=linkflow
DB_NAME=linkflow
DB_PORT=5432

# App uses these (Viper env format)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=linkflow
DATABASE_PASSWORD=linkflow
DATABASE_NAME=linkflow

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# JWT
JWT_SECRET=local-dev-secret-change-in-prod-32ch

# Encryption
CRYPTO_ENCRYPTION_KEY=local-dev-encryption-key-32chars

# Scaling
API_REPLICAS=1
WORKER_REPLICAS=1
