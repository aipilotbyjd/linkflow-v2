# LinkFlow - Local Development Environment
# Copy to local.env and fill in your values: cp local.env.example local.env

APP_ENV=local
APP_DEBUG=true

# Database
DB_USER=linkflow
DB_PASSWORD=linkflow
DB_NAME=linkflow
DB_PORT=5432
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=linkflow
DATABASE_PASSWORD=linkflow
DATABASE_NAME=linkflow

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# JWT (generate a secure random key for production)
JWT_SECRET=local-dev-secret-change-in-prod-32ch

# Encryption (must be exactly 32 chars for AES-256)
CRYPTO_ENCRYPTION_KEY=local-dev-encryption-key-32chars

# Scaling
API_REPLICAS=1
WORKER_REPLICAS=1

# OAuth Providers (get credentials from provider developer consoles)
# Google: https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8090/api/v1/auth/oauth/google/callback

# GitHub: https://github.com/settings/developers
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=http://localhost:8090/api/v1/auth/oauth/github/callback

# Microsoft: https://portal.azure.com/
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_REDIRECT_URL=http://localhost:8090/api/v1/auth/oauth/microsoft/callback
