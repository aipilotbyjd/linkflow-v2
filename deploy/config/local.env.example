# ============================================================================
# LinkFlow - Local Development Environment
# Copy to local.env and fill in values
# ============================================================================

# App
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=linkflow
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=linkflow
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT
JWT_SECRET=change-me-to-32-characters-minimum
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (for credentials)
ENCRYPTION_KEY=change-me-to-32-characters-here

# Scaling (local = 1 each)
API_REPLICAS=1
WORKER_REPLICAS=1

# Optional: OAuth (leave empty for local)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Optional: Email (leave empty for local)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost

# Optional: Storage (leave empty for local filesystem)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Optional: Stripe (leave empty for local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
