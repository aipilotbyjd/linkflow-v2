# ============================================================================
# LinkFlow - Staging Environment
# Copy to staging.env and fill in values
# ============================================================================

# App
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging-api.linkflow.io
APP_FRONTEND_URL=https://staging.linkflow.io

# Database
DB_HOST=${DB_HOST}
DB_PORT=5432
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=linkflow_staging
DB_SSLMODE=require

# Redis
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# JWT
JWT_SECRET=${JWT_SECRET}
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# Scaling (mirror production but smaller)
API_REPLICAS=1
WORKER_REPLICAS=1

# OAuth
OAUTH_GOOGLE_CLIENT_ID=${OAUTH_GOOGLE_CLIENT_ID}
OAUTH_GOOGLE_CLIENT_SECRET=${OAUTH_GOOGLE_CLIENT_SECRET}
OAUTH_GITHUB_CLIENT_ID=${OAUTH_GITHUB_CLIENT_ID}
OAUTH_GITHUB_CLIENT_SECRET=${OAUTH_GITHUB_CLIENT_SECRET}

# Email
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=noreply@linkflow.io

# Storage
S3_ENDPOINT=${S3_ENDPOINT}
S3_BUCKET=linkflow-staging
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
S3_REGION=auto

# Stripe (test keys for staging)
STRIPE_SECRET_KEY=${STRIPE_TEST_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_TEST_WEBHOOK_SECRET}

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
