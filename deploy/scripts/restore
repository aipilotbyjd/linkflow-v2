#!/bin/bash
# ============================================================================
# LinkFlow Restore Script
# Usage: ./restore <env> <backup-file>
# Example: ./restore staging linkflow-production-db-20240115-120000.sql.gz
# ============================================================================

set -e

ENV=${1:-staging}
BACKUP_FILE=$2
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { echo -e "${BLUE}[RESTORE]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

[[ -z "$BACKUP_FILE" ]] && error "Usage: ./restore <env> <backup-file>"

# Load environment
source "$SCRIPT_DIR/../config/$ENV.env" 2>/dev/null || true

main() {
    warn "⚠️  This will REPLACE the $ENV database!"
    warn "Backup file: $BACKUP_FILE"
    read -p "Are you sure? (y/N) " -n 1 -r
    echo
    [[ $REPLY =~ ^[Yy]$ ]] || exit 0
    
    log "Downloading backup..."
    aws s3 cp \
        "s3://$BACKUP_S3_BUCKET/$BACKUP_FILE" \
        "/tmp/$BACKUP_FILE" \
        --endpoint-url "$BACKUP_S3_ENDPOINT"
    
    log "Restoring database..."
    gunzip -c "/tmp/$BACKUP_FILE" | PGPASSWORD="$DB_PASSWORD" psql \
        -h "$DB_HOST" \
        -p "${DB_PORT:-5432}" \
        -U "$DB_USER" \
        -d "$DB_NAME"
    
    # Cleanup
    rm -f "/tmp/$BACKUP_FILE"
    
    success "Database restored from $BACKUP_FILE"
}

main
