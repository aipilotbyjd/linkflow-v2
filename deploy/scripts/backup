#!/bin/bash
# ============================================================================
# LinkFlow Backup Script
# Usage: ./backup <env> [type]
# Examples:
#   ./backup production           # Full backup
#   ./backup production db        # Database only
#   ./backup production redis     # Redis only
# ============================================================================

set -e

ENV=${1:-production}
TYPE=${2:-full}
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TIMESTAMP=$(date +%Y%m%d-%H%M%S)

GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { echo -e "${BLUE}[BACKUP]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }

# Load environment
source "$SCRIPT_DIR/../config/$ENV.env" 2>/dev/null || true

backup_postgres() {
    log "Backing up PostgreSQL..."
    
    BACKUP_FILE="linkflow-$ENV-db-$TIMESTAMP.sql.gz"
    
    # Dump database
    PGPASSWORD="$DB_PASSWORD" pg_dump \
        -h "$DB_HOST" \
        -p "${DB_PORT:-5432}" \
        -U "$DB_USER" \
        -d "$DB_NAME" \
        | gzip > "/tmp/$BACKUP_FILE"
    
    # Upload to S3/R2
    if [[ -n "$BACKUP_S3_ENDPOINT" ]]; then
        log "Uploading to S3..."
        aws s3 cp "/tmp/$BACKUP_FILE" \
            "s3://$BACKUP_S3_BUCKET/$ENV/db/$BACKUP_FILE" \
            --endpoint-url "$BACKUP_S3_ENDPOINT"
    fi
    
    # Cleanup local
    rm -f "/tmp/$BACKUP_FILE"
    
    success "Database backup complete: $BACKUP_FILE"
}

backup_redis() {
    log "Backing up Redis..."
    
    BACKUP_FILE="linkflow-$ENV-redis-$TIMESTAMP.rdb"
    
    # Trigger save
    redis-cli -h "$REDIS_HOST" -p "${REDIS_PORT:-6379}" -a "$REDIS_PASSWORD" BGSAVE
    sleep 5
    
    # Copy RDB file
    if [[ -n "$BACKUP_S3_ENDPOINT" ]]; then
        log "Uploading to S3..."
        # Note: Actual implementation depends on Redis access
        success "Redis backup triggered"
    fi
}

backup_full() {
    log "Starting full backup for $ENV..."
    echo ""
    
    backup_postgres
    backup_redis
    
    echo ""
    success "Full backup complete!"
}

main() {
    log "Environment: $ENV"
    log "Type: $TYPE"
    log "Timestamp: $TIMESTAMP"
    echo ""
    
    case $TYPE in
        full) backup_full ;;
        db|postgres) backup_postgres ;;
        redis) backup_redis ;;
        *) echo "Unknown type: $TYPE. Use: full, db, redis" && exit 1 ;;
    esac
}

main
