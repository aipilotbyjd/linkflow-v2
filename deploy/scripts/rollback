#!/bin/bash
# ============================================================================
# LinkFlow Rollback Script
# Usage: ./rollback <env> [platform]
# ============================================================================

set -e

ENV=${1:-production}
PLATFORM=${2:-compose}
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { echo -e "${BLUE}[ROLLBACK]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

rollback_compose() {
    log "Rolling back $ENV with Docker Compose..."
    cd "$SCRIPT_DIR/../compose"
    
    # Get previous image
    PREVIOUS=$(ENV=$ENV docker compose images --format json | jq -r '.[0].Tag' | head -1)
    
    if [[ -z "$PREVIOUS" ]]; then
        error "No previous version found"
    fi
    
    log "Rolling back to: $PREVIOUS"
    ENV=$ENV docker compose down
    ENV=$ENV docker compose up -d
    
    success "Rolled back $ENV!"
}

rollback_fly() {
    log "Rolling back $ENV on Fly.io..."
    APP_NAME="linkflow-$ENV"
    
    # List releases
    log "Recent releases:"
    fly releases --app "$APP_NAME" | head -10
    
    # Get previous release
    PREVIOUS=$(fly releases --app "$APP_NAME" --json | jq -r '.[1].Version')
    
    log "Rolling back to version: $PREVIOUS"
    fly deploy --image "registry.fly.io/$APP_NAME:$PREVIOUS" --app "$APP_NAME"
    
    success "Rolled back $ENV on Fly.io!"
}

rollback_k8s() {
    log "Rolling back $ENV on Kubernetes..."
    NAMESPACE="linkflow-$ENV"
    
    # Show rollout history
    log "Rollout history:"
    kubectl rollout history deployment/linkflow-api -n "$NAMESPACE"
    
    # Rollback
    kubectl rollout undo deployment/linkflow-api -n "$NAMESPACE"
    kubectl rollout undo deployment/linkflow-worker -n "$NAMESPACE"
    
    # Wait for rollout
    kubectl rollout status deployment/linkflow-api -n "$NAMESPACE" --timeout=300s
    
    success "Rolled back $ENV on Kubernetes!"
}

main() {
    warn "⚠️  Rolling back $ENV..."
    read -p "Are you sure? (y/N) " -n 1 -r
    echo
    [[ $REPLY =~ ^[Yy]$ ]] || exit 0
    
    case $PLATFORM in
        compose|coolify) rollback_compose ;;
        fly) rollback_fly ;;
        k8s|kubernetes) rollback_k8s ;;
        *) error "Unknown platform: $PLATFORM" ;;
    esac
}

main
