# =============================================================================
# LinkFlow Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production, set these in your deployment platform (Railway, Render, etc.)
# Never commit .env files with real credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME=linkflow
APP_ENVIRONMENT=development          # development, staging, production, test
APP_DEBUG=true                       # Set to false in production
APP_URL=http://localhost:8080        # Public API URL
APP_FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=8090                            # Railway/Render/Heroku use PORT
SERVER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------------------------
# Option 1: Connection URL (recommended for cloud databases)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Option 2: Individual variables
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres           # REQUIRED - change in production
DATABASE_NAME=linkflow
DATABASE_SSLMODE=disable             # Use 'require' in production

# -----------------------------------------------------------------------------
# REDIS (Required)
# -----------------------------------------------------------------------------
# Option 1: Connection URL (recommended for cloud Redis)
# REDIS_URL=redis://user:password@host:6379/0
# REDIS_URL=rediss://user:password@host:6379/0  # 'rediss' for TLS

# Option 2: Individual variables
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                      # Set if Redis requires authentication
REDIS_DB=0
REDIS_TLS=false                      # Use true for cloud Redis (Upstash, etc.)

# -----------------------------------------------------------------------------
# JWT (Required)
# -----------------------------------------------------------------------------
JWT_SECRET=                          # REQUIRED - min 32 characters
                                     # Generate: openssl rand -base64 32

# -----------------------------------------------------------------------------
# ENCRYPTION (Required for production)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=                      # 32 characters for AES-256-GCM
                                     # Generate: openssl rand -base64 32 | head -c 32

# -----------------------------------------------------------------------------
# OAUTH (Optional - enable as needed)
# -----------------------------------------------------------------------------
# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Microsoft OAuth
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# S3 / OBJECT STORAGE (Optional)
# -----------------------------------------------------------------------------
S3_ENDPOINT=                         # Leave empty for AWS S3, set for MinIO/R2
S3_REGION=us-east-1
S3_BUCKET=linkflow
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Alternative AWS env vars (also supported)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# -----------------------------------------------------------------------------
# STRIPE (Optional)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=                   # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=               # whsec_...
STRIPE_PUBLISHABLE_KEY=              # pk_test_... or pk_live_...

# -----------------------------------------------------------------------------
# EMAIL / SMTP (Optional)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=LinkFlow

# -----------------------------------------------------------------------------
# TRACING (Optional)
# -----------------------------------------------------------------------------
TRACING_ENDPOINT=                    # OTLP endpoint, e.g., http://localhost:4318

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info                       # trace, debug, info, warn, error
LOG_FORMAT=json                      # json, console, text

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
#
# [ ] APP_ENVIRONMENT=production
# [ ] APP_DEBUG=false
# [ ] DATABASE_SSLMODE=require (or use DATABASE_URL with sslmode)
# [ ] REDIS_TLS=true (if using cloud Redis like Upstash)
# [ ] JWT_SECRET is strong (64+ chars recommended)
# [ ] ENCRYPTION_KEY is set (32 chars)
# [ ] All secrets via env vars, never in config files
# [ ] CORS origins properly configured (no wildcards)
# [ ] Rate limiting enabled
# [ ] LOG_LEVEL=info or higher
# =============================================================================

# =============================================================================
# QUICK START COMMANDS
# =============================================================================
# Generate JWT secret:
#   openssl rand -base64 64
#
# Generate Encryption key:
#   openssl rand -base64 32 | head -c 32
#
# Test database connection:
#   psql $DATABASE_URL -c "SELECT 1"
#
# Test Redis connection:
#   redis-cli -u $REDIS_URL ping
# =============================================================================
